# Real-credentials integration pipeline configuration.
# Copy this file to tests/integration/secrets.cfg and fill it in.
# It is gitignored — never commit it.
#
# Every value can instead be provided via environment variables, which take
# priority: FLOCK_API_URL, FLOCK_GAME_ID, FLOCK_GAME_VERSION_ID, FLOCK_API_KEY,
# and any of the [pipeline] keys below as FLOCK_<KEY_UPPER> (e.g. FLOCK_RUN_PHASES).
#
# Delete this whole header (everything above the first section) and keep only the
# sections below when filling the file in.

[credentials]
# Base URL of the Flock API. Override only if you self-host.
# Values may be quoted or plain; the loader handles both (including https:// URLs).
api_url = "https://api-flock.qwacks.com"
game_id =
game_version_id =
api_key =

[pipeline]
# Ordered comma-separated phases. Supported:
#   device         register/login a fresh device player          (CREATE)
#   currency       add funds + update the wallet player data     (UPDATE)
#   achievement    unlock an achievement + read back the list (UPDATE, optional)
#   notification   schedule then cancel a notification           (CREATE -> DELETE, optional)
#   shop           purchase then consume a shop item             (CREATE -> DELETE, optional)
#   leaderboard    read a leaderboard + my rank                  (READ, optional)
#   game_config    read a named game config                      (READ, optional)
# device always runs first; currency is the default UPDATE step. Add optional phases
# only AFTER the templates/items they need exist (the pipeline verifies them and
# prints exactly what is missing before running UPDATE/DELETE).
run_phases = device,currency

# Stable across runs? Leave empty for a fresh disposable player per run.
# If set, the device player is re-used (login instead of re-register).
device_id =
player_name = GUT Integration Test

# UPDATE step template. The pipeline requires a player-data template tagged
# "currency" whose schema contains every field listed, and a wallet row for the
# registered player. See the pipeline output for how to create any of these.
currency_template_tag = currency
currency_fields = gold

# --- Optional phases (only required if listed in run_phases) ---
# The achievement phase unlocks achievement_name and then reads back the whole list.
# It uses the player-data template tagged "achievement" (auto-created by Content ->
# Achievement Config) — no tag knob needed. achievement_name must be one of that
# template's schema members, matching the name under Content -> Achievement Config.
achievement_name =
notification_template =
shop_item_id =
leaderboard_name =
game_config_name =